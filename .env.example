# ============================================================================
# QuickOffer Support Bot - Environment Configuration
# ============================================================================
# Copy this file to .env and replace placeholder values before running.
# IMPORTANT: Do NOT commit .env to version control - it's already in .gitignore
# ============================================================================

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_APPROVAL_CHAT_ID=123456789

# Database Configuration (PostgreSQL)
# Use asyncpg driver for async support
DATABASE_URL=postgresql+asyncpg://support_bot_user:your_secure_password@localhost:5432/support_bot
DATABASE_ECHO=false

# M2M API Configuration
# These URLs point to internal microservices (fuckhr-api, jobs-api)
M2M_API_KEY=your_m2m_api_key_here
FUCKHR_API_BASE_URL=http://localhost:8001
JOBS_API_BASE_URL=http://localhost:8002

# Use mock clients for offline development/testing
USE_MOCKS=false

# LLM Configuration
# OpenAI-compatible endpoint: local LiteLLM, OpenRouter, or another proxy.
# Local demos work without a key when the proxy allows it.
LLM_PROVIDER_KEY=
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:4000/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional dedicated reranker (for example, ZeroEntropy). Leave blank to disable reranking.
RERANKER_PROVIDER=local
RERANKER_BASE_URL=
RERANKER_MODEL=

# ZeroEntropy Configuration (alternative embedder/reranker provider)
ZERO_ENTROPY_API_KEY=
ZERO_ENTROPY_BASE_URL=https://api.zeroentropy.ai/v1

# OpenRouter Configuration (alternative LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4-turbo

# Provider Mode Selection
# Options: "litellm" (use LiteLLM for all), "zeroentropy_openrouter" (use ZeroEntropy + OpenRouter)
PROVIDER_MODE=litellm

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# RAG Configuration (Mode B - LLM Investigation)
# Knowledge base retrieval settings
RAG_KB_BASE_URL=http://localhost:8003
RAG_MAX_RETRIEVAL_COUNT=5
RAG_CONFIDENCE_THRESHOLD=0.7

# Handoff Configuration
# When to escalate to human operators
HANDOFF_TIMEOUT_MINUTES=120
HANDOFF_FACTS_RETENTION_DAYS=30
