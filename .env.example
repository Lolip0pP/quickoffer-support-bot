# Copy this file to .env and replace every TODO(MAX) value before deployment.
# TODO(MAX): inject production values from a secret manager; do not commit .env.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=

# Support database
DATABASE_URL=postgresql+asyncpg://support_bot_user:change_me@localhost:5432/support_bot
DATABASE_ECHO=false

# Private M2M transport
M2M_API_KEY=
FUCKHR_API_BASE_URL=http://fuckhr-api:8001
JOBS_API_BASE_URL=http://jobs-api:8002

# LLM (read-only investigation only)
LLM_PROVIDER_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo

# Internal callbacks. Use a long random secret in each environment.
INTERNAL_WEBHOOK_TOKEN=

# Browser clients are disabled unless explicit trusted origins are supplied.
CORS_ORIGINS=[]
