# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_APPROVAL_CHAT_ID=123456789

# Database Configuration
DATABASE_URL=postgresql+asyncpg://support_bot_user:secure_password_change_me@postgres:5432/support_bot
DATABASE_ECHO=false
DB_PASSWORD=secure_password_change_me

# M2M API Configuration
M2M_API_KEY=your_m2m_api_key_here
FUCKHR_API_BASE_URL=http://localhost:8001
JOBS_API_BASE_URL=http://localhost:8002

# LLM Configuration
LLM_PROVIDER_KEY=your_llm_provider_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# RAG Configuration (Mode B)
RAG_KB_BASE_URL=http://localhost:8003
RAG_MAX_RETRIEVAL_COUNT=5
RAG_CONFIDENCE_THRESHOLD=0.7

# Handoff Configuration
HANDOFF_TIMEOUT_MINUTES=120
HANDOFF_FACTS_RETENTION_DAYS=30
